#!/usr/bin/env python3
"""Watch a GitHub PR and print ONE stdout line per actionable event.

Run per PR by `pr-watch-monitor`, whose output a Claude Code session
receives as notifications; the silence between events is the entire
point. See the git-workflow skill
(claude/skills/git-workflow/SKILL.md) Phase 5 for the reaction protocol.

Usage: GH_REPO=OWNER/REPO pr-monitor <pr-number> [interval-seconds]

The PR is looked up on github.com, with the token `gh` holds for that host.

The events it prints, one per stdout line, and what each guarantees are
the plugin's contract with its callers, documented in the plugin's
skills/watch/SKILL.md; a change to an event's name, format, or timing
changes that file too.

Runs on Python 3.9, the version of the macOS `/usr/bin/python3`, with the
standard library alone.
"""

import http.client
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request

ENDPOINT = "https://api.github.com/graphql"
# The host is pinned on both sides of the request, since a token `gh` reads
# for the host in GH_HOST would otherwise be sent to github.com.
TOKEN_COMMAND = ["gh", "auth", "token", "--hostname", "github.com"]
# Turns a call that stops responding for this long into a failed poll, which
# reports, rather than a stalled loop, which stays silent.
TIMEOUT_SECONDS = 60

# The values that never warrant waking anybody are the only ones spelled
# here, so a value added later reports rather than vanishes.
QUIET_CHECK_VALUES = {
    "SUCCESS",
    "NEUTRAL",
    "SKIPPED",
    "PENDING",
    "EXPECTED",
    "QUEUED",
    "WAITING",
    "REQUESTED",
    "IN_PROGRESS",
}

# Checks and `reviewDecision` are state derived from the head commit and the
# branch's protection, with no item marking their changes, so they come from
# this query rather than the timeline. The rollup covers the first 100 checks
# on the head commit, Actions or not.
PR_QUERY = """
query($owner:String!,$repo:String!,$num:Int!){
  repository(owner:$owner,name:$repo){
    pullRequest(number:$num){
      state
      reviewDecision
      headRefOid
      commits(last:1){
        nodes{
          commit{
            statusCheckRollup{
              contexts(first:100){
                nodes{
                  ... on CheckRun{ name status conclusion }
                  ... on StatusContext{ context state }
                }
              }
            }
          }
        }
      }
    }
  }
}
"""

# A reply in an existing review thread adds no timeline item, so
# review-thread comments come from this query, which also carries the
# resolved and outdated state they are filtered on.
THREADS_QUERY = """
query($owner:String!,$repo:String!,$num:Int!){
  repository(owner:$owner,name:$repo){
    pullRequest(number:$num){
      reviewThreads(first:100){
        nodes{
          isResolved
          isOutdated
          comments(first:100){ nodes{ id author{login __typename} path line } }
        }
      }
    }
  }
}
"""

# The PR's timeline is the source of the events in `itemTypes`, each of
# which GitHub records as an item on the conversation: comments, reviews,
# review requests, draft flips, dismissals, merge, close, and reopen.
# Each item prints once, by node ID. `last` keeps the newest items in the
# window however long the PR's history grows. Commits are left out of
# `itemTypes`, since a burst of them would push the other items out of
# that window.
#
# A review request is reported from its event rather than diffed from
# `reviewRequests`: a reviewer who submits a review drops out of
# `reviewRequests` without a ReviewRequestRemovedEvent, so only the
# events tell a removal from a fulfilled request.
TIMELINE_QUERY = """
query($owner:String!,$repo:String!,$num:Int!){
  repository(owner:$owner,name:$repo){
    pullRequest(number:$num){
      timelineItems(last:100,itemTypes:[ISSUE_COMMENT,PULL_REQUEST_REVIEW,REVIEW_REQUESTED_EVENT,REVIEW_REQUEST_REMOVED_EVENT,READY_FOR_REVIEW_EVENT,CONVERT_TO_DRAFT_EVENT,REVIEW_DISMISSED_EVENT,MERGED_EVENT,CLOSED_EVENT,REOPENED_EVENT]){
        nodes{
          __typename
          ... on Node{ id }
          ... on IssueComment{ author{login __typename} }
          ... on PullRequestReview{ state body author{login __typename} }
          ... on ReviewRequestedEvent{ actor{login} requestedReviewer{ ...reviewer } }
          ... on ReviewRequestRemovedEvent{ actor{login} requestedReviewer{ ...reviewer } }
        }
      }
    }
  }
}
fragment reviewer on RequestedReviewer{
  __typename
  ... on User{login}
  ... on Bot{login}
  ... on Mannequin{login}
  ... on Team{combinedSlug}
  ... on EnterpriseTeam{combinedSlug}
}
"""

TIMELINE_EVENT_LINES = {
    "ReadyForReviewEvent": "READY_FOR_REVIEW",
    "ConvertToDraftEvent": "CONVERT_TO_DRAFT",
    "ReviewDismissedEvent": "REVIEW_DISMISSED",
    "MergedEvent": "STATE: MERGED",
    "ClosedEvent": "STATE: CLOSED",
    "ReopenedEvent": "STATE: OPEN",
}


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Fail on a redirect, since urllib carries `Authorization` to its target."""

    def redirect_request(self, *args, **kwargs):
        return None


OPENER = urllib.request.build_opener(NoRedirect)


def read_token():
    try:
        result = subprocess.run(
            TOKEN_COMMAND,
            capture_output=True,
            text=True,
            timeout=TIMEOUT_SECONDS,
            check=True,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return result.stdout.strip() or None


class Client:
    def __init__(self, owner, repo, number):
        self.variables = {"owner": owner, "repo": repo, "num": number}
        self.token = None

    def query(self, query):
        """Return the parsed response, or None when the request fails.

        A 401 takes the token again from `gh` and retries once, which covers
        a token that expired since it was read.
        """
        payload = json.dumps({"query": query, "variables": self.variables}).encode()
        for _ in range(2):
            if self.token is None:
                self.token = read_token()
            if self.token is None:
                return None
            request = urllib.request.Request(
                ENDPOINT,
                data=payload,
                headers={
                    "Authorization": "bearer " + self.token,
                    "Content-Type": "application/json",
                    "User-Agent": "pr-watch",
                },
            )
            try:
                with OPENER.open(request, timeout=TIMEOUT_SECONDS) as response:
                    return json.load(response)
            except urllib.error.HTTPError as error:
                if error.code != 401:
                    return None
                self.token = None
            except (OSError, http.client.HTTPException, ValueError):
                return None
        return None


def dig(value, *keys):
    """Follow keys through nested dicts, giving None where any is missing.

    >>> dig({"a": {"b": 1}}, "a", "b")
    1
    >>> dig({"a": None}, "a", "b") is None
    True
    >>> dig(None, "a") is None
    True
    """
    for key in keys:
        if not isinstance(value, dict):
            return None
        value = value.get(key)
    return value


def nodes_of(connection):
    return [node for node in dig(connection, "nodes") or [] if isinstance(node, dict)]


def who(account):
    """Label an author for a reaction turn to classify without re-fetching.

    `__typename` is the authoritative Bot/User signal. For review-thread
    comments this is a per-comment hint only: pr-reaction.md's targeting
    policy still requires walking every comment in the thread before
    mutating it.

    >>> who({"__typename": "Bot", "login": "devin"})
    '[BOT] devin'
    >>> who({"__typename": "User", "login": "ikuwow"})
    '[USER] ikuwow'
    >>> who(None)
    '[USER] ?'
    """
    kind = "[BOT]" if dig(account, "__typename") == "Bot" else "[USER]"
    return f"{kind} {dig(account, 'login') or '?'}"


def reviewer_label(reviewer):
    """Label a requested reviewer, which can be a team as well as a user or bot.

    >>> reviewer_label({"__typename": "Team", "combinedSlug": "org/team"})
    '[TEAM] org/team'
    >>> reviewer_label({"__typename": "User", "login": "ikuwow"})
    '[USER] ikuwow'
    >>> reviewer_label(None)
    '[?] ?'
    """
    kind = (dig(reviewer, "__typename") or "?").upper()
    name = dig(reviewer, "login") or dig(reviewer, "combinedSlug") or "?"
    return f"[{kind}] {name}"


def timeline_line(item):
    """Return the event line of a timeline item, or None for one left out.

    Pending reviews are left out because a review keeps its ID when
    submitted, so recording it while pending would mark it seen before it
    could print. Empty-body reviews are left out too: an empty approval or
    change request moves `REVIEW:`, and an empty comment review carries only
    thread comments, which `NEW_COMMENT` reports. An item kind without a
    line of its own prints its `__typename`, so it reports rather than
    vanishes.

    >>> bot = {"__typename": "Bot", "login": "devin"}
    >>> timeline_line({"__typename": "IssueComment", "author": bot})
    'NEW_TOP_COMMENT: [BOT] devin'
    >>> review = {"__typename": "PullRequestReview", "author": bot}
    >>> timeline_line({**review, "state": "COMMENTED", "body": "Looks off"})
    'NEW_REVIEW: [BOT] devin COMMENTED'
    >>> timeline_line({**review, "state": "PENDING", "body": "Draft"}) is None
    True
    >>> timeline_line({**review, "state": "APPROVED", "body": ""}) is None
    True
    >>> team = {"__typename": "Team", "combinedSlug": "org/team"}
    >>> actor = {"login": "ikuwow"}
    >>> timeline_line({"__typename": "ReviewRequestedEvent", "requestedReviewer": team, "actor": actor})
    'REVIEW_REQUESTED: [TEAM] org/team by ikuwow'
    >>> timeline_line({"__typename": "ReviewRequestRemovedEvent", "requestedReviewer": team, "actor": None})
    'REVIEW_REQUEST_REMOVED: [TEAM] org/team by ?'
    >>> timeline_line({"__typename": "MergedEvent"})
    'STATE: MERGED'
    >>> timeline_line({"__typename": "SomeNewEvent"})
    'SomeNewEvent'
    """
    kind = item.get("__typename")
    if kind == "IssueComment":
        return f"NEW_TOP_COMMENT: {who(item.get('author'))}"
    if kind == "PullRequestReview":
        if item.get("state") == "PENDING" or not item.get("body"):
            return None
        return f"NEW_REVIEW: {who(item.get('author'))} {item.get('state')}"
    if kind in ("ReviewRequestedEvent", "ReviewRequestRemovedEvent"):
        event = "REVIEW_REQUESTED" if kind == "ReviewRequestedEvent" else "REVIEW_REQUEST_REMOVED"
        reviewer = reviewer_label(item.get("requestedReviewer"))
        return f"{event}: {reviewer} by {dig(item, 'actor', 'login') or '?'}"
    return TIMELINE_EVENT_LINES.get(kind, kind)


def timeline_items(timeline):
    """Return (id, line) per reported item, in timeline order.

    One pass in timeline order means a reviewer removed and requested again
    within one interval reads as requested.

    >>> merged = {"__typename": "MergedEvent", "id": "M1"}
    >>> pending = {"__typename": "PullRequestReview", "id": "R1", "state": "PENDING", "body": "Draft"}
    >>> timeline_items({"nodes": [None, pending, merged]})
    [('M1', 'STATE: MERGED')]
    >>> seen = set()
    >>> new_lines(timeline_items({"nodes": [pending]}), seen, False)
    []
    >>> new_lines(timeline_items({"nodes": [{**pending, "state": "COMMENTED"}]}), seen, False)
    ['NEW_REVIEW: [USER] ? COMMENTED']
    """
    items = ((node.get("id"), timeline_line(node)) for node in nodes_of(timeline))
    return [(item_id, line) for item_id, line in items if line is not None]


def thread_comment_items(threads):
    """Return (id, line) per comment in the unresolved, current threads.

    >>> comment = {"id": "C1", "author": {"__typename": "Bot", "login": "devin"}, "path": "a.py", "line": 3}
    >>> current = {"isResolved": False, "isOutdated": False, "comments": {"nodes": [comment]}}
    >>> thread_comment_items({"nodes": [current]})
    [('C1', 'NEW_COMMENT: [BOT] devin a.py:3')]
    >>> thread_comment_items({"nodes": [{**current, "isResolved": True}, {**current, "isOutdated": True}]})
    []
    >>> file_level = {"id": "C2", "author": None, "path": "a.py", "line": None}
    >>> thread_comment_items({"nodes": [{**current, "comments": {"nodes": [file_level]}}]})
    [('C2', 'NEW_COMMENT: [USER] ? a.py:?')]
    """
    return [
        (
            comment.get("id"),
            f"NEW_COMMENT: {who(comment.get('author'))} "
            f"{comment.get('path') or '?'}:{comment.get('line') or '?'}",
        )
        for thread in nodes_of(threads)
        if thread.get("isResolved") is False and thread.get("isOutdated") is False
        for comment in nodes_of(thread.get("comments"))
    ]


def new_lines(items, seen, seeding):
    """Record the items' IDs in `seen`, and return the lines of those not seen.

    With `seeding` the IDs are recorded and no line returns, so state that
    held before the source's first success stays silent.

    >>> seen = set()
    >>> new_lines([("a", "A")], seen, True)
    []
    >>> new_lines([("a", "A"), ("b", "B")], seen, False)
    ['B']
    >>> new_lines([("a", "A"), ("b", "B")], seen, False)
    []
    """
    lines = [line for item_id, line in items if item_id not in seen]
    seen.update(item_id for item_id, _ in items)
    return [] if seeding else lines


def rollup_checks(pr):
    """Return (name, value) per check, or None for a rollup of no known shape.

    A commit with no checks has a null `statusCheckRollup`.

    >>> run = {"name": "lint", "status": "COMPLETED", "conclusion": "FAILURE"}
    >>> status = {"context": "ci/x", "state": "ERROR"}
    >>> rolling = {"name": "test", "status": "IN_PROGRESS", "conclusion": None}
    >>> contexts = {"contexts": {"nodes": [run, status, rolling]}}
    >>> rollup_checks({"commits": {"nodes": [{"commit": {"statusCheckRollup": contexts}}]}})
    [('lint', 'FAILURE'), ('ci/x', 'ERROR'), ('test', 'IN_PROGRESS')]
    >>> rollup_checks({"commits": {"nodes": [{"commit": {"statusCheckRollup": None}}]}})
    []
    >>> rollup_checks({"commits": {"nodes": []}})
    []
    >>> rollup_checks({}) is None
    True
    >>> rollup_checks({"commits": {"nodes": [{"commit": {"statusCheckRollup": {"contexts": None}}}]}}) is None
    True
    >>> no_conclusion = {"name": "x", "status": "COMPLETED", "conclusion": None}
    >>> rollup_checks({"commits": {"nodes": [{"commit": {"statusCheckRollup": {"contexts": {"nodes": [no_conclusion]}}}}]}})
    [('x', '')]
    """
    commits = dig(pr, "commits", "nodes")
    if not isinstance(commits, list):
        return None
    rollup = dig(commits[-1], "commit", "statusCheckRollup") if commits else None
    if rollup is None:
        return []
    contexts = dig(rollup, "contexts", "nodes")
    if not isinstance(contexts, list):
        return None
    checks = []
    for context in contexts:
        name = dig(context, "name") or dig(context, "context") or "?"
        status = dig(context, "status") or "COMPLETED"
        if status == "COMPLETED":
            value = dig(context, "conclusion") or dig(context, "state") or ""
        else:
            value = status
        checks.append((name, value))
    return checks


def watch(client, interval, parent):
    """Poll until the PR ends or the parent process is gone.

    First-poll seeding: do not print events for state that already held when
    this process started. Only transitions during its lifetime should wake
    the operator. `prev_decision` stays None until the first successful pull
    request query, and the threads and timeline sources seed on their own
    first success, so a source that failed at first does not report
    everything it held once it recovers. `CHECK` and a terminal `STATE` are
    the exceptions: a check already red is the reader's problem now, and a PR
    already merged or closed ends this process at the end of the first poll,
    so both report rather than seed.
    """
    prev_decision = None
    prev_sha = ""
    prev_check = {}
    failed = set()
    seen_comments = set()
    seen_timeline = set()
    seed_threads = True
    seed_timeline = True
    announced = False

    def report(source, ok):
        # One line per outage, not per poll: an unauthorized token or an
        # outage persists for many intervals, and a line each time would
        # drown the silence the rest of the script maintains.
        if ok:
            failed.discard(source)
        elif source not in failed:
            print(f"POLL_ERROR: {source}")
            failed.add(source)

    while True:
        # A `pr-watch-monitor` killed without running its trap would otherwise
        # leave this loop polling GitHub until the PR closes. Checked before
        # the poll so a failing poll does not skip it.
        if parent is not None:
            try:
                os.kill(parent, 0)
            except OSError:
                return

        body = client.query(PR_QUERY)
        pr = dig(body, "data", "repository", "pullRequest")
        # Field errors leave a parseable body with nulls in it, where a null
        # rollup would read as a commit with no checks. Requiring `state`
        # rules out a response without the PR, whose empty `state` would read
        # as an open PR while its empty `headRefOid` reset `prev_check`.
        pr_ok = not dig(body, "errors") and bool(dig(pr, "state"))
        report("graphql (pull request)", pr_ok)
        if not pr_ok:
            # A token that cannot read the PR still answers 200, so no 401
            # would replace it once `gh auth switch` fixes the access.
            client.token = None
            time.sleep(interval)
            continue
        state = pr["state"]
        decision = pr.get("reviewDecision") or ""
        head_sha = pr.get("headRefOid") or ""

        # `prev_decision` tracks the empty value too: a dismissal clears
        # `reviewDecision`, and holding the stale one here would then swallow
        # the re-approval that follows.
        if decision and prev_decision is not None and decision != prev_decision:
            print(f"REVIEW: {decision}")
        prev_decision = decision

        # A new head retires the old commit's checks, and a check that lands
        # on the same value it held there would otherwise compare equal and
        # stay silent.
        if head_sha != prev_sha:
            prev_check = {}
            prev_sha = head_sha
        checks = rollup_checks(pr)
        report("graphql (checks)", checks is not None)
        # Every value is tracked, settled or not, so a rerun passing back
        # through a running state is a change again on the way out.
        for name, value in checks or []:
            if prev_check.get(name) != value and value not in QUIET_CHECK_VALUES:
                # The head sha tells a failure reported again after a
                # restart from a new one.
                print(f"CHECK: {name} ({value}) @{head_sha[:7]}")
            prev_check[name] = value

        # Testing the field rather than the response: GraphQL answers an
        # error with a parseable body, which would otherwise read as a
        # healthy poll and clear a running outage's suppression.
        threads = dig(client.query(THREADS_QUERY), "data", "repository", "pullRequest", "reviewThreads")
        report("graphql (threads)", threads is not None)
        if threads is not None:
            for line in new_lines(thread_comment_items(threads), seen_comments, seed_threads):
                print(line)
            seed_threads = False

        timeline = dig(client.query(TIMELINE_QUERY), "data", "repository", "pullRequest", "timelineItems")
        report("graphql (timeline)", timeline is not None)
        if timeline is not None:
            lines = new_lines(timeline_items(timeline), seen_timeline, seed_timeline)
            for line in lines:
                print(line)
            # The timeline is read after the pull request query, so its last
            # `STATE` line is the newer reading and replaces `state`.
            state_lines = [line for line in lines if line.startswith("STATE: ")]
            if state_lines:
                state = state_lines[-1][len("STATE: "):]
                if state != "OPEN":
                    return
            seed_timeline = False

        # The end the timeline has not printed, as when seeding swallowed it
        # or the timeline poll fails.
        if state in ("MERGED", "CLOSED"):
            print(f"STATE: {state}")
            return

        if not announced and not seed_threads and not seed_timeline:
            print("WATCHING")
            announced = True

        time.sleep(interval)


__test__ = {
    "watch": """
>>> def body(**fields): return {"data": {"repository": {"pullRequest": fields}}}
>>> def run(*polls):
...     answers = iter(answer for poll in polls for answer in poll)
...     watch(type("Stub", (), {"query": lambda self, query: next(answers)})(), 0, None)
>>> def poll(state="OPEN", sha="aaaaaaa", decision=None, checks=(), comments=(), items=()):
...     rollup = {"contexts": {"nodes": [{"name": n, "status": "COMPLETED", "conclusion": c} for n, c in checks]}}
...     thread = {"isResolved": False, "isOutdated": False, "comments": {"nodes": [{"id": c, "path": "a", "line": 1} for c in comments]}}
...     return (body(state=state, headRefOid=sha, reviewDecision=decision, commits={"nodes": [{"commit": {"statusCheckRollup": rollup}}]}),
...             body(reviewThreads={"nodes": [thread]}),
...             body(timelineItems={"nodes": [{"__typename": k, "id": k} for k in items]}))
>>> red = [("lint", "FAILURE")]

State held at the start stays silent except a red check, an unchanged check
does not repeat, and a new head or a rerun reports it again.

>>> run(poll(decision="APPROVED", checks=red, comments=["C1"], items=["IssueComment"]),
...     poll(checks=red, comments=["C1"], items=["IssueComment"]),
...     poll(decision="APPROVED", checks=red, comments=["C1", "C2"], items=["IssueComment"]),
...     poll(sha="bbbbbbb", checks=red),
...     poll(sha="bbbbbbb", checks=[("lint", "IN_PROGRESS")]),
...     poll(sha="bbbbbbb", checks=red),
...     poll(sha="bbbbbbb", checks=red, items=["MergedEvent", "ClosedEvent"]))
CHECK: lint (FAILURE) @aaaaaaa
WATCHING
REVIEW: APPROVED
NEW_COMMENT: [USER] ? a:1
CHECK: lint (FAILURE) @bbbbbbb
CHECK: lint (FAILURE) @bbbbbbb
STATE: MERGED
STATE: CLOSED

A PR that ended before the watch began prints its end once.

>>> run(poll(state="MERGED", items=["MergedEvent"]))
STATE: MERGED

A close and a reopen within one interval keep the watch going.

>>> run(poll(), poll(state="CLOSED", items=["ClosedEvent", "ReopenedEvent"]), poll(state="MERGED"))
WATCHING
STATE: CLOSED
STATE: OPEN
STATE: MERGED

An outage prints one line per source, and a source that failed at first seeds
when it recovers.

>>> pr, threads, timeline = poll(items=["IssueComment"])
>>> run((None,), (None,), (pr, threads, None), (pr, threads, None), poll(items=["IssueComment"]), poll(state="MERGED"))
POLL_ERROR: graphql (pull request)
POLL_ERROR: graphql (timeline)
WATCHING
STATE: MERGED

A failed pull request query drops the token, so the next poll reads it again.

>>> client = type("Stub", (), {"token": "old", "query": lambda self, query: None if self.token else body(state="MERGED")})()
>>> watch(client, 0, None)
POLL_ERROR: graphql (pull request)
POLL_ERROR: graphql (checks)
POLL_ERROR: graphql (threads)
POLL_ERROR: graphql (timeline)
STATE: MERGED
"""
}


def usage():
    print("Usage: GH_REPO=OWNER/REPO pr-monitor <pr-number> [interval-seconds]", file=sys.stderr)


def main(argv):
    if not 2 <= len(argv) <= 3:
        usage()
        return 1
    number = argv[1]
    interval = argv[2] if len(argv) == 3 else "60"
    owner_repo = os.environ.get("GH_REPO", "")
    # Reject anything that isn't a positive integer, so a flag such as
    # `--help` errors out rather than polling for a PR that cannot exist.
    for value, pattern, rule in (
        (number, r"[1-9][0-9]*", "<pr-number> must be a positive integer"),
        (interval, r"[1-9][0-9]*", "[interval-seconds] must be a positive integer"),
        (owner_repo, r"[^/\s]+/[^/\s]+", "GH_REPO must be OWNER/REPO"),
    ):
        if not re.fullmatch(pattern, value):
            print(f"pr-monitor: {rule}, got: {value}", file=sys.stderr)
            usage()
            return 2
    owner, repo = owner_repo.split("/")
    parent = os.environ.get("PR_WATCH_PARENT")

    # Each line reaches the session through a pipe, which would otherwise
    # hold it back in a block buffer until the buffer fills.
    sys.stdout.reconfigure(line_buffering=True)
    watch(Client(owner, repo, int(number)), int(interval), int(parent) if parent else None)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
