#!/usr/bin/env bash

# Watch a GitHub PR and emit ONE stdout line per actionable event.
# Requires bash 4+ (associative arrays). The shebang is /usr/bin/env bash
# so the brew-installed bash on PATH is picked up on macOS, where the
# default /bin/bash is 3.2.
# Run per PR by `pr-watch-monitor`, whose output a Claude Code session
# receives as notifications; the silence between events is the entire
# point. See the git-workflow skill
# (claude/skills/git-workflow/SKILL.md) Phase 5 for the reaction protocol.
#
# Usage: pr-monitor <pr-number> [interval-seconds]
#
# The PR is looked up in GH_REPO (OWNER/REPO) when set, otherwise in the
# repository of the working directory.
#
# The events it prints, one per stdout line, and what each guarantees are
# the plugin's contract with its callers, documented in the plugin's
# skills/watch/SKILL.md; a change to an event's name, format, or timing
# changes that file too. A failing `gh pr view` skips the rest of that poll.

set -eu

usage() {
  echo "Usage: pr-monitor <pr-number> [interval-seconds]" >&2
}

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  usage
  exit 1
fi

pr="$1"
interval="${2:-60}"

# Reject anything that isn't a positive integer. Without this, flags like
# `--help` fall through to `gh pr view --help`, whose non-JSON output makes
# the poll loop `continue` forever instead of erroring out.
if ! [[ "$pr" =~ ^[1-9][0-9]*$ ]]; then
  echo "pr-monitor: <pr-number> must be a positive integer, got: $pr" >&2
  usage
  exit 2
fi
if ! [[ "$interval" =~ ^[1-9][0-9]*$ ]]; then
  echo "pr-monitor: [interval-seconds] must be a positive integer, got: $interval" >&2
  usage
  exit 2
fi

# `gh pr view` honors GH_REPO but `gh repo view` does not, so GH_REPO is
# read here to keep both calls on the same repository.
owner_repo="${GH_REPO:-$(gh repo view --json nameWithOwner --jq .nameWithOwner)}"
owner="${owner_repo%/*}"
repo="${owner_repo#*/}"

prev_state=""
prev_decision=""
prev_isdraft=""
prev_ci_sha=""
declare -A prev_check=()
declare -A poll_failed=()
seen_comments="$(mktemp)"
seen_top_comments="$(mktemp)"
seen_reviews="$(mktemp)"
seen_review_requests="$(mktemp)"
trap 'rm -f "$seen_comments" "$seen_top_comments" "$seen_reviews" "$seen_review_requests"' EXIT

# First-poll seeding: do not emit events for state that already held when
# this process started. Only transitions during its lifetime should wake
# the operator. `first_poll` flips after the first successful `gh pr view`,
# and each GraphQL source seeds on its own first success, so a source that
# failed at first does not report everything it held once it recovers.
# `CHECK` and a terminal `STATE` are the exceptions — a check already red
# is the reader's problem now, and a PR already merged or closed ends this
# process at the end of the first poll, so both report rather than seed.
first_poll=1
seed_threads=1
seed_reviews=1
announced=0

# One line per outage, not per poll: an unauthorized token or an outage
# persists for many intervals, and a line each time would drown the
# silence the rest of the script maintains.
poll_error() {
  if [ -z "${poll_failed[$1]:-}" ]; then
    echo "POLL_ERROR: $1"
    poll_failed[$1]=1
  fi
}

poll_ok() {
  unset "poll_failed[$1]"
}

# `__typename` on each author is the authoritative Bot/User signal. It
# flows into the event line as a `[BOT]` or `[USER]` prefix on the author
# label so a reaction turn can classify without re-fetching. For
# review-thread comments this is a per-comment hint only — pr-reaction.md's
# targeting policy still requires walking every comment in the thread
# before mutating it.

# shellcheck disable=SC2016 # GraphQL query: $vars are query variables
threads_query='query($owner:String!,$repo:String!,$num:Int!){
  repository(owner:$owner,name:$repo){
    pullRequest(number:$num){
      reviewThreads(first:100){
        nodes{
          isResolved
          isOutdated
          comments(first:100){ nodes{ id author{login __typename} path line } }
        }
      }
    }
  }
}'

# Top-level PR comments are fetched via GraphQL rather than `gh pr view
# --json comments` because that `author` object omits `__typename`, and
# the same Bot/User classification is needed as for review threads and
# reviews. Piggybacks on `reviews_query` to avoid an extra round-trip.
#
# Review requests are read from the timeline events rather than diffed
# from `reviewRequests`: a reviewer who submits a review drops out of
# `reviewRequests` without a ReviewRequestRemovedEvent, so only the
# events tell a removal from a fulfilled request. `last` keeps the newest
# events in the window however long the PR's history grows.
# shellcheck disable=SC2016 # GraphQL query: $vars are query variables
reviews_query='query($owner:String!,$repo:String!,$num:Int!){
  repository(owner:$owner,name:$repo){
    pullRequest(number:$num){
      reviews(first:100){
        nodes{ id state body author{login __typename} }
      }
      comments(first:100){
        nodes{ id author{login __typename} }
      }
      timelineItems(last:100,itemTypes:[REVIEW_REQUESTED_EVENT,REVIEW_REQUEST_REMOVED_EVENT]){
        nodes{
          __typename
          ... on ReviewRequestedEvent{ id actor{login} requestedReviewer{ ...reviewer } }
          ... on ReviewRequestRemovedEvent{ id actor{login} requestedReviewer{ ...reviewer } }
        }
      }
    }
  }
}
fragment reviewer on RequestedReviewer{
  __typename
  ... on User{login}
  ... on Bot{login}
  ... on Mannequin{login}
  ... on Team{combinedSlug}
}'

# Emit one line per not-yet-seen comment ID. `fresh` is tab-separated
# "id<TAB>author[<TAB>extra]" lines; the optional extra field (e.g.
# "path:line") is appended to the label when present. Seen IDs persist in
# seen_file across polls so each comment fires exactly once. With
# `seeding` at 1 the IDs are recorded and nothing is emitted.
emit_new() {
  local fresh="$1" seen_file="$2" label="$3" seeding="$4"
  [ -z "$fresh" ] && return 0
  local sorted_fresh sorted_seen new
  sorted_fresh="$(echo "$fresh" | cut -f1 | sort -u)"
  sorted_seen="$(sort -u "$seen_file")"
  new="$(comm -23 <(echo "$sorted_fresh") <(echo "$sorted_seen") || true)"
  [ -z "$new" ] && return 0
  if [ "$seeding" -eq 0 ]; then
    # Two inputs to awk: `$fresh` on stdin supplies the records to scan;
    # `$new` (the IDs to emit) goes via the environment, not `awk -v`,
    # because BWK awk (the macOS default) rejects a literal newline in a
    # -v assignment ("awk: newline in string").
    echo "$fresh" | ids_nl="$new" awk -F'\t' -v label="$label" '
      BEGIN { n = split(ENVIRON["ids_nl"], a, "\n"); for (i = 1; i <= n; i++) seen[a[i]] = 1 }
      ($1 in seen) { print label ": " $2 ($3 != "" ? " " $3 : "") }
    '
  fi
  echo "$sorted_fresh" >> "$seen_file"
}

# Print the review-request timeline events of one `__typename` from
# `reviews_json` in `emit_new`'s format. The reviewer's `__typename`
# becomes the label prefix, since a request can name a team as well as a
# user or bot.
review_requests() {
  echo "$reviews_json" | jq -r --arg t "$1" '
    .data.repository.pullRequest.timelineItems.nodes[]
    | select(.__typename == $t)
    | .requestedReviewer as $r
    | "\(.id)\t[\(($r.__typename // "?") | ascii_upcase)] \($r.login // $r.combinedSlug // "?")\tby \(.actor.login // "?")"' \
    2>/dev/null || true
}

while true; do
  # Under `pr-watch-monitor`, a watcher killed without running its trap
  # would otherwise leave this loop polling GitHub until the PR closes.
  # Checked before the poll so a failing poll does not skip it.
  if [ -n "${PR_WATCH_PARENT:-}" ] && ! kill -0 "$PR_WATCH_PARENT" 2>/dev/null; then
    exit 0
  fi

  # `timeout` turns a call that hangs into a failed poll, which reports,
  # rather than a stalled loop, which stays silent.
  pr_json="$(timeout 60 gh pr view "$pr" --json state,isDraft,reviewDecision,statusCheckRollup,headRefOid 2>/dev/null || true)"
  # Requiring `.state` rather than mere parseability: `{}` parses, and an
  # empty `state` reaches the comparison below while an empty `headRefOid`
  # resets `prev_check` twice over, replaying every failing check.
  if ! echo "$pr_json" | jq -e '.state? // empty' >/dev/null 2>&1; then
    poll_error "gh pr view"
    sleep "$interval"
    continue
  fi
  poll_ok "gh pr view"
  state="$(echo "$pr_json" | jq -r '.state // ""')"
  # `//` would treat false as missing and turn a ready PR into "".
  isdraft="$(echo "$pr_json" | jq -r 'if .isDraft == null then "" else (.isDraft | tostring) end')"
  decision="$(echo "$pr_json" | jq -r '.reviewDecision // ""')"
  head_sha="$(echo "$pr_json" | jq -r '.headRefOid // ""')"

  if [ "$state" != "$prev_state" ]; then
    if [ "$first_poll" -eq 0 ] || [ "$state" = MERGED ] || [ "$state" = CLOSED ]; then
      echo "STATE: $state"
    fi
    prev_state="$state"
  fi

  if [ -n "$isdraft" ] && [ "$isdraft" != "$prev_isdraft" ]; then
    if [ "$first_poll" -eq 0 ] && [ "$isdraft" = "false" ]; then
      echo "READY_FOR_REVIEW"
    fi
    prev_isdraft="$isdraft"
  fi

  # `prev_decision` tracks the empty value too: a dismissal clears
  # `reviewDecision`, and holding the stale one here would then swallow
  # the re-approval that follows.
  if [ "$decision" != "$prev_decision" ]; then
    if [ "$first_poll" -eq 0 ] && [ -n "$decision" ]; then
      echo "REVIEW: $decision"
    fi
    prev_decision="$decision"
  fi

  # A new head retires the old commit's checks, and a check that lands on
  # the same value it held there would otherwise compare equal and stay
  # silent.
  if [ "$head_sha" != "$prev_ci_sha" ]; then
    prev_check=()
    prev_ci_sha="$head_sha"
  fi
  # The rollup rides along on the poll above and covers every check on the
  # head commit, Actions or not. Every value it holds is tracked, settled
  # or not, so a rerun passing back through a running state is a change
  # again on the way out; the ones that never warrant waking anybody are
  # the only names spelled here, so a value added later reports rather
  # than vanishes.
  if ! echo "$pr_json" | jq -e '.statusCheckRollup | type == "array"' >/dev/null 2>&1; then
    poll_error "gh pr view (rollup)"
  else
    poll_ok "gh pr view (rollup)"
  fi
  while IFS=$'\t' read -r check_name check_state; do
    [ -z "$check_name" ] && continue
    # `unseen` rather than an empty default: a check reporting COMPLETED
    # with no conclusion holds the empty string, which would otherwise
    # match a check never seen before and never report.
    if [ "$check_state" != "${prev_check[$check_name]-unseen}" ]; then
      case "$check_state" in
        SUCCESS|NEUTRAL|SKIPPED|PENDING|EXPECTED|QUEUED|WAITING|REQUESTED|IN_PROGRESS) ;;
        # The head sha tells a failure reported again after a restart
        # from a new one.
        *) echo "CHECK: $check_name ($check_state) @${head_sha:0:7}" ;;
      esac
      prev_check[$check_name]="$check_state"
    fi
  done < <(echo "$pr_json" | jq -r '
    .statusCheckRollup[]?
    | (.name // .context // "?") as $n
    | (if (.status // "COMPLETED") == "COMPLETED"
       then (.conclusion // .state // "") else .status end) as $c
    | "\($n)\t\($c)"' || true)

  threads_json="$(timeout 60 gh api graphql -f owner="$owner" -f repo="$repo" -F num="$pr" -f query="$threads_query" 2>/dev/null || true)"
  # Testing the field rather than the string: GraphQL answers an error
  # with a parseable body on stdout, which a non-empty test would read as
  # a healthy poll and, worse, clear a running outage's suppression.
  if ! echo "$threads_json" | jq -e '.data.repository.pullRequest.reviewThreads' >/dev/null 2>&1; then
    poll_error "gh api graphql (threads)"
  else
    poll_ok "gh api graphql (threads)"
    fresh_comments="$(echo "$threads_json" | jq -r '
      .data.repository.pullRequest.reviewThreads.nodes[]
      | select(.isResolved == false and .isOutdated == false)
      | .comments.nodes[]
      | "\(.id)\t\(if .author.__typename == "Bot" then "[BOT]" else "[USER]" end) \(.author.login)\t\(.path // "?"):\(.line // "?")"' \
      2>/dev/null || true)"
    emit_new "$fresh_comments" "$seen_comments" "NEW_COMMENT" "$seed_threads"
    seed_threads=0
  fi

  # Reviews API surfaces `state=COMMENTED` reviews (e.g. Devin Review, or a
  # human submitting "Comment") that neither change `reviewDecision` nor
  # appear in reviewThreads / issue comments. Empty-body reviews are
  # filtered out: empty APPROVED / CHANGES_REQUESTED are already covered
  # by the `REVIEW:` decision event, and an empty COMMENTED has nothing
  # to read.
  reviews_json="$(timeout 60 gh api graphql -f owner="$owner" -f repo="$repo" -F num="$pr" -f query="$reviews_query" 2>/dev/null || true)"
  if ! echo "$reviews_json" | jq -e '.data.repository.pullRequest.reviews' >/dev/null 2>&1; then
    poll_error "gh api graphql (reviews)"
  else
    poll_ok "gh api graphql (reviews)"
    fresh_top="$(echo "$reviews_json" | jq -r '
      .data.repository.pullRequest.comments.nodes[]
      | "\(.id)\t\(if .author.__typename == "Bot" then "[BOT]" else "[USER]" end) \(.author.login)"' \
      2>/dev/null || true)"
    emit_new "$fresh_top" "$seen_top_comments" "NEW_TOP_COMMENT" "$seed_reviews"

    fresh_reviews="$(echo "$reviews_json" | jq -r '
      .data.repository.pullRequest.reviews.nodes[]
      | select(.state != "PENDING" and (.body // "") != "")
      | "\(.id)\t\(if .author.__typename == "Bot" then "[BOT]" else "[USER]" end) \(.author.login)\t\(.state)"' \
      2>/dev/null || true)"
    emit_new "$fresh_reviews" "$seen_reviews" "NEW_REVIEW" "$seed_reviews"

    emit_new "$(review_requests ReviewRequestedEvent)" \
      "$seen_review_requests" "REVIEW_REQUESTED" "$seed_reviews"
    emit_new "$(review_requests ReviewRequestRemovedEvent)" \
      "$seen_review_requests" "REVIEW_REQUEST_REMOVED" "$seed_reviews"
    seed_reviews=0
  fi

  case "$state" in
    MERGED|CLOSED) exit 0 ;;
  esac

  if [ "$announced" -eq 0 ] && [ "$seed_threads" -eq 0 ] && [ "$seed_reviews" -eq 0 ]; then
    echo "WATCHING"
    announced=1
  fi

  first_poll=0
  sleep "$interval"
done
