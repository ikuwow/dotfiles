#!/usr/bin/env bash

# Register the PRs a Claude Code session watches. `pr-watch-monitor`, run
# by the pr-watch plugin for the whole session, reports their events.
#
# Usage:
#   pr-watch add <pr>             watch a PR
#   pr-watch remove <pr>          stop watching it
#   pr-watch list                 print this session's registered PRs not
#                                 recorded as finished; exits 1 whenever no
#                                 watcher runs
#
# <pr> is `<owner>/<repo>#<number>`, the form `list` prints, or a bare
# number in GH_REPO (OWNER/REPO) when set, otherwise in the current
# repository. `add` also takes `<host>/<owner>/<repo>#<number>` and any
# letter case, looks the PR up, and lists it in the form `list` prints.
#
# The watch list is one file per session, keyed by CLAUDE_CODE_SESSION_ID,
# so concurrent sessions in one working tree each wake only for their own
# PRs. When no watcher runs under that ID, the list of the watcher that
# the same Claude Code process started is used instead, since Bash and the
# watcher can hold different IDs: a Claude Code restarted into an earlier
# conversation gives Bash that conversation's ID and the watcher a new
# one, and `/clear` gives Bash a new ID while the watcher may keep its own.
#
# Each add appends `<owner>/<repo>#<number><TAB><token>` with a fresh
# token, and the watcher starts a PR whose latest token it has not started
# yet, so an add restarts a watch that stopped.

set -eu

usage() {
  echo "Usage: pr-watch add|remove <owner>/<repo>#<number>|<number> | list" >&2
}

if [ -z "${CLAUDE_CODE_SESSION_ID:-}" ]; then
  echo "pr-watch: CLAUDE_CODE_SESSION_ID is not set; run it from a Claude Code session" >&2
  exit 2
fi
state="${XDG_STATE_HOME:-$HOME/.local/state}/pr-watch"
mkdir -p "$state"

# Whether the watcher of session ID $1 runs. Matching the session ID on the
# watcher's command line keeps a reused PID, including one now held by
# another session's watcher, from passing for this session's.
watcher_runs() {
  local pid
  pid="$(cat "$state/$1.pid" 2>/dev/null || true)"
  if [ -z "$pid" ]; then
    return 1
  fi
  ps -ww -p "$pid" -o command= | grep -qF "pr-watch-monitor $1"
}

# The session ID of the watcher that the Claude Code process this command
# runs under started. The plugin starts the watcher through a shell, so
# the watcher's grandparent is that Claude Code process.
sibling_session_id() {
  local ancestors=" " pid=$$ watcher id grandparent
  while [ -n "$pid" ] && [ "$pid" -gt 1 ]; do
    pid="$(ps -o ppid= -p "$pid" | tr -d ' ')"
    ancestors="$ancestors$pid "
  done
  while read -r watcher id; do
    grandparent="$(ps -o ppid= -p "$(ps -o ppid= -p "$watcher" | tr -d ' ')" | tr -d ' ')"
    if [ -n "$grandparent" ] && [[ "$ancestors" == *" $grandparent "* ]]; then
      echo "$id"
      return
    fi
  done < <(ps -ww -A -o pid=,command= | awk '$0 ~ /pr-watch-monitor [0-9a-f-]+$/ { print $1, $NF }')
}

id="$CLAUDE_CODE_SESSION_ID"
if ! watcher_runs "$id"; then
  sibling="$(sibling_session_id)"
  if [ -n "$sibling" ]; then
    id="$sibling"
  fi
fi
list="$state/$id"
touch "$list"

entry_for() {
  if [[ "$1" =~ ^[^/#[:space:]]+/[^/#[:space:]]+#[1-9][0-9]*$ ]]; then
    echo "$1"
    return
  fi
  if ! [[ "$1" =~ ^[1-9][0-9]*$ ]]; then
    echo "pr-watch: <pr> must be <owner>/<repo>#<number> or a positive integer, got: $1" >&2
    exit 2
  fi
  local repo
  # set -e is off inside the `$(entry_for ...)` call, so a failed lookup
  # exits here explicitly.
  repo="${GH_REPO:-$(gh repo view --json nameWithOwner --jq .nameWithOwner)}" || exit 1
  if [ -z "$repo" ]; then
    echo "pr-watch: could not resolve the repository of $PWD" >&2
    exit 1
  fi
  echo "$repo#$1"
}

# gh answers with the PR's URL, which carries the repository's own letter
# case, and fails for a number that is no PR there; the entry is that URL
# with its scheme and host stripped, so an add lists one spelling per PR
# and only a PR that exists.
add_entry_for() {
  local repo="" num url
  if [[ "$1" =~ ^([^#[:space:]]+)#([1-9][0-9]*)$ ]]; then
    repo="${BASH_REMATCH[1]}"
    num="${BASH_REMATCH[2]}"
  elif [[ "$1" =~ ^[1-9][0-9]*$ ]]; then
    num="$1"
  else
    echo "pr-watch: <pr> must be <owner>/<repo>#<number> or a positive integer, got: $1" >&2
    exit 2
  fi
  url="$(gh pr view "$num" ${repo:+-R "$repo"} --json url --jq .url)" || exit 1
  url="${url#https://*/}"
  echo "${url%/pull/*}#${url##*/}"
}

watcher_running() {
  watcher_runs "$id"
}

no_watcher="no watcher runs for this session ID or under this Claude Code process; the pr-watch plugin may be missing, the session non-interactive, or the watcher stopped"

case "${1:-}" in
  add|remove)
    if [ $# -ne 2 ]; then
      usage
      exit 2
    fi
    if [ "$1" = add ]; then
      entry="$(add_entry_for "$2")"
      # Without a running watcher no event would arrive for the entry, so
      # the add fails before listing it.
      if ! watcher_running; then
        echo "pr-watch: not watching $entry: $no_watcher" >&2
        exit 1
      fi
      printf '%s\t%s-%s\n' "$entry" "$(date +%s)" "$$" >> "$list"
      echo "watching $entry"
    else
      entry="$(entry_for "$2")"
      if ! cut -f1 "$list" | grep -qxF "$entry"; then
        echo "pr-watch: $entry is not in this session ID's watch list; pass the <owner>/<repo>#<number> that 'pr-watch list' prints, and note that after a /clear the PR may sit in the earlier ID's list" >&2
        exit 1
      fi
      tmp="$(mktemp "$list.XXXXXX")"
      awk -F'\t' -v e="$entry" '$1 != e' "$list" > "$tmp"
      mv "$tmp" "$list"
      echo "stopped watching $entry"
    fi
    ;;
  list)
    # An entry is finished when the watcher recorded its latest token.
    touch "$list.done"
    # FILENAME rather than NR == FNR, which an empty .done file would fool.
    awk -F'\t' 'FILENAME == ARGV[1] { done[$1 "\t" $2] = 1; next } { latest[$1] = $2 }
      END { for (e in latest) if (!((e "\t" latest[e]) in done)) print e }' \
      "$list.done" "$list" | sort
    if ! watcher_running; then
      echo "pr-watch: none of these is watched: $no_watcher" >&2
      exit 1
    fi
    ;;
  *)
    usage
    exit 2
    ;;
esac
