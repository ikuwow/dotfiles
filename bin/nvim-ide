#!/bin/bash

# Start Neovim as the whole IDE, with the overlay config in ~/.config/nvim-ide
# Usage: nvim-ide [dir]
#
# nvim reads the overlay's init.lua through -u in place of the main
# init.vim, and the overlay sources the main config before adding the IDE
# layout, so both share one plugin list, data directory, and colorscheme.
# Plain nvim never reads the overlay. nvim starts in dir, the current
# directory by default, which claudecode.nvim registers as the workspace for
# Claude Code.

set -eu

usage="Usage: nvim-ide [dir]"

for arg in "$@"; do
  case "$arg" in
    -h | --help)
      echo "$usage"
      exit 0
      ;;
    -*)
      echo "Error: unknown option: $arg" >&2
      echo "$usage" >&2
      exit 1
      ;;
  esac
done

if [ $# -gt 1 ]; then
  echo "$usage" >&2
  exit 1
fi

init="${XDG_CONFIG_HOME:-$HOME/.config}/nvim-ide/init.lua"
if [ ! -e "$init" ]; then
  echo "Error: $init not found; link xdg-config/nvim-ide there" >&2
  exit 1
fi

cd "${1:-.}"
exec nvim -u "$init"
