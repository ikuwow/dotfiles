#!/bin/bash

# Delete local branches whose content the default branch already holds,
# and prune stale worktree entries. A branch is removed if it matches
# either of the following, checked in this priority order (first match
# wins):
#   - merged:   reachable from the default branch (git branch --merged)
#   - squashed: tree already in default but commit not reachable
#               (the cherry-pick-id trick)
# A branch neither check matches is left alone, whatever its upstream
# says, since the commits it carries exist nowhere else.
# Worktrees attached to removable branches are removed first, without
# --force; a dirty worktree skips that branch and the loop continues.
# Clean detached-HEAD worktrees are removed too. Worktrees with
# initialized submodules are listed for removal by hand, and a listed
# branch worktree's branch goes on the next run after that removal.
#
# Origin of the squash-merge detection trick:
# https://github.com/not-an-aardvark/git-delete-squashed#sh

set -euo pipefail

if [ -n "$(git status --porcelain)" ]; then
  echo "git-cleanup-branches: uncommitted changes present; commit or stash first." >&2
  exit 1
fi

# Resolve the default branch the same way the `git home` alias does, and
# fall back to a local main or master when origin cannot say, so cleanup
# still runs without a remote or offline after `git home` failed.
if default_ref=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null) \
  || { git remote set-head origin -a && default_ref=$(git symbolic-ref refs/remotes/origin/HEAD); }; then
  default_branch=${default_ref#refs/remotes/origin/}
elif git rev-parse --verify -q main >/dev/null; then
  default_branch=main
else
  default_branch=master
fi

git checkout -q "$default_branch"

# Reap stale worktree entries (working dir gone, admin dir orphaned, etc.).
# `-v` writes one line per pruned entry to stderr; merge it into stdout so
# `wc -l` can count them.
pruned_count=$(git worktree prune -v 2>&1 | wc -l | tr -d ' ')

# Build branch -> worktree path map once.
worktree_map=$(git worktree list --porcelain | awk '
  /^worktree /  { path = substr($0, 10) }
  /^branch /    {
    ref = substr($0, 8)
    sub(/^refs\/heads\//, "", ref)
    print ref "\t" path
  }
')

lookup_worktree() {
  local branch="$1"
  printf '%s\n' "$worktree_map" | awk -F'\t' -v b="$branch" '$1 == b { print $2; exit }'
}

# `git worktree remove` refuses a worktree with initialized submodules even
# when it is clean, and its --force would also discard work inside them, so
# such a worktree is only listed with the command to remove it by hand. A
# failed check counts as having submodules, which lists rather than removes.
has_submodules() {
  local wt="$1" status
  status=$(git -C "$wt" submodule status --recursive) || return 0
  grep -q '^[^-]' <<<"$status"
}

candidate_count=0
list_candidate() {
  local wt="$1" what="$2"
  echo "git-cleanup-branches: $what has initialized submodules; check it, then remove it with: git worktree remove --force '$wt'"
  candidate_count=$((candidate_count + 1))
}

# Branches reachable from the default branch (excluding the default itself).
# `--merged` always lists the default branch; filter it out.
merged_set=$(git branch --merged "$default_branch" --format='%(refname:short)' \
  | grep -vxF "$default_branch" || true)

merged_count=0
squashed_count=0
removed_count=0

while read -r branch; do
  [ -z "$branch" ] && continue
  [ "$branch" = "$default_branch" ] && continue

  # Classify in priority order (first match wins, counted once):
  #   merged > squashed.
  # The cherry trick matches both squash and conventional merges, so
  # `--merged` must be checked first to attribute conventional merges
  # correctly.
  category=""
  if printf '%s\n' "$merged_set" | grep -qxF "$branch"; then
    category=merged
  elif mergeBase=$(git merge-base "$default_branch" "$branch" 2>/dev/null) \
       && [[ $(git cherry "$default_branch" "$(git commit-tree "$(git rev-parse "$branch^{tree}")" -p "$mergeBase" -m _)") == "-"* ]]; then
    category=squashed
  fi

  if [ -z "$category" ]; then
    continue
  fi

  wt_path=$(lookup_worktree "$branch")
  if [ -n "$wt_path" ]; then
    if has_submodules "$wt_path"; then
      list_candidate "$wt_path" "worktree of '$branch' at $wt_path"
      continue
    fi
    if ! git worktree remove "$wt_path"; then
      echo "git-cleanup-branches: skip '$branch' (worktree at $wt_path not removable; uncommitted changes?)" >&2
      continue
    fi
  fi

  if ! git branch -D "$branch"; then
    echo "git-cleanup-branches: skip '$branch' (branch deletion failed)" >&2
    continue
  fi

  case "$category" in
    merged)   merged_count=$((merged_count + 1)) ;;
    squashed) squashed_count=$((squashed_count + 1)) ;;
  esac
  removed_count=$((removed_count + 1))
done < <(git for-each-ref refs/heads/ '--format=%(refname:short)')

# A worktree in the middle of a rebase shows as detached, and a clean one
# stopped at an `edit` or `break` would lose its operation state. A failed
# check counts as an operation in progress.
operation_in_progress() {
  local wt="$1" state path
  for state in rebase-merge rebase-apply sequencer MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
    path=$(git -C "$wt" rev-parse --path-format=absolute --git-path "$state") || return 0
    if [ -e "$path" ]; then
      return 0
    fi
  done
  return 1
}

# A detached worktree has no branch for the loop above to reach. It is
# removed without --force, so git refuses it when it has changes, and it is
# kept first when any of these holds:
#   - a rebase, merge, cherry-pick, revert, or bisect is in progress
#   - a tracked file is marked skip-worktree or assume-unchanged, which
#     hides its local changes from git
#   - its HEAD or refs/worktree/* reach a commit no branch, tag, or
#     remote-tracking ref holds, since per-worktree refs go with the
#     worktree
# A check that fails keeps the worktree. The first entry is the main
# worktree, which git never removes.
detached_count=0
while read -r wt_path; do
  [ -z "$wt_path" ] && continue
  if has_submodules "$wt_path"; then
    list_candidate "$wt_path" "detached worktree at $wt_path"
    continue
  fi
  if operation_in_progress "$wt_path"; then
    echo "git-cleanup-branches: keep detached worktree at $wt_path (operation in progress)" >&2
    continue
  fi
  if ! flags=$(git -C "$wt_path" ls-files -v) || grep -q '^[a-zS]' <<<"$flags"; then
    echo "git-cleanup-branches: keep detached worktree at $wt_path (skip-worktree or assume-unchanged files)" >&2
    continue
  fi
  if ! unshared=$(git -C "$wt_path" rev-list -n1 HEAD --glob='refs/worktree/*' \
    --not --branches --tags --remotes) || [ -n "$unshared" ]; then
    echo "git-cleanup-branches: keep detached worktree at $wt_path (holds commits no shared ref holds)" >&2
    continue
  fi
  if ! git worktree remove "$wt_path"; then
    echo "git-cleanup-branches: keep detached worktree at $wt_path (not removable; uncommitted changes?)" >&2
    continue
  fi
  detached_count=$((detached_count + 1))
done < <(git worktree list --porcelain | awk '
  /^worktree / { path = substr($0, 10); n++ }
  /^detached$/ { if (n > 1) print path }
')

echo "removed $removed_count branches (merged: $merged_count, squashed: $squashed_count) and $detached_count detached worktrees; listed $candidate_count worktrees with submodules; pruned $pruned_count worktree entries"
