#!/usr/bin/env bash

# Register the PRs a Claude Code session watches. `pr-watch-monitor`, run
# by the pr-watch plugin for the whole session, reports their events.
#
# Usage:
#   pr-watch add <pr-number>      watch a PR of GH_REPO (OWNER/REPO) when
#                                 set, otherwise of the current repository
#   pr-watch remove <pr-number>   stop watching it
#   pr-watch list                 print this session's watched PRs
#
# The watch list is one file per session, keyed by CLAUDE_CODE_SESSION_ID,
# so concurrent sessions in one working tree each wake only for their own
# PRs. `/clear` gives Bash a new session ID, so if the running watcher
# keeps the ID it started with, PRs added after a `/clear` go to a list it
# does not read until the session restarts.
#
# Each add appends `<owner>/<repo>#<number><TAB><token>` with a fresh
# token, and the watcher starts a PR whose latest token it has not started
# yet, so an add restarts a watch that stopped.

set -eu

usage() {
  echo "Usage: pr-watch add|remove <pr-number> | list" >&2
}

if [ -z "${CLAUDE_CODE_SESSION_ID:-}" ]; then
  echo "pr-watch: CLAUDE_CODE_SESSION_ID is not set; run it from a Claude Code session" >&2
  exit 2
fi
list="${XDG_STATE_HOME:-$HOME/.local/state}/pr-watch/$CLAUDE_CODE_SESSION_ID"
mkdir -p "${list%/*}"
touch "$list"

entry_for() {
  if ! [[ "$1" =~ ^[1-9][0-9]*$ ]]; then
    echo "pr-watch: <pr-number> must be a positive integer, got: $1" >&2
    exit 2
  fi
  local repo
  # Checked here because a failed substitution inside echo's arguments
  # would leave the status 0 and the entry `#<number>`.
  repo="${GH_REPO:-$(gh repo view --json nameWithOwner --jq .nameWithOwner)}" || exit 1
  if [ -z "$repo" ]; then
    echo "pr-watch: could not resolve the repository of $PWD" >&2
    exit 1
  fi
  echo "$repo#$1"
}

case "${1:-}" in
  add|remove)
    if [ $# -ne 2 ]; then
      usage
      exit 2
    fi
    entry="$(entry_for "$2")"
    if [ "$1" = add ]; then
      printf '%s\t%s-%s\n' "$entry" "$(date +%s)" "$$" >> "$list"
      # Without a running watcher the entry would wait in the list and no
      # event would ever arrive, so the add fails loudly instead. Matching
      # the command line keeps a reused PID from passing for the watcher.
      pid="$(cat "$list.pid" 2>/dev/null || true)"
      if [ -z "$pid" ] || ! ps -p "$pid" -o command= | grep -q 'pr-watch-monitor'; then
        echo "pr-watch: listed $entry, but no watcher runs for this session ID; the pr-watch plugin may be missing, the session non-interactive, or the ID changed by a /clear" >&2
        exit 1
      fi
      echo "watching $entry"
    else
      # An entry missing here may sit in another session ID's list (after
      # a `/clear`), where it would keep being watched.
      if ! cut -f1 "$list" | grep -qxF "$entry"; then
        echo "pr-watch: $entry is not in this session's watch list" >&2
        exit 1
      fi
      status=0
      awk -F'\t' -v e="$entry" '$1 != e' "$list" > "$list.tmp" || status=$?
      if [ "$status" -ne 0 ]; then
        exit "$status"
      fi
      mv "$list.tmp" "$list"
      echo "stopped watching $entry"
    fi
    ;;
  list)
    cut -f1 "$list" | sort -u
    ;;
  *)
    usage
    exit 2
    ;;
esac
