theme = Japanesque

shell-integration-features = no-cursor, sudo
# no-cursor: Specify cursor style manually
# sudo: Enable shell integration of sudo command

# Specify cursor style
cursor-style = block
cursor-style-blink = true

# Default window size
window-height = 68
window-width = 112

macos-titlebar-style = tabs

keybind = global:ctrl+alt+super+t=toggle_quick_terminal
quick-terminal-position = center
quick-terminal-size = 1080px, 50%

font-family = "Monaco"
font-family = "BIZ UDGothic Bold"
font-style = Regular
font-size = 12
# Disable ligatures
font-feature = -calt, -liga, -dlig

# Resize every surface at once to force a fresh font load, aimed at CJK glyphs
# drawn in a wrong face after a display change (whether it recovers them is unconfirmed)
# Ref: https://github.com/ikuwow/dotfiles/issues/540
keybind = all:super+alt+equal=increase_font_size:1
keybind = all:super+alt+0=reset_font_size

# Do not dim unfocused splits
unfocused-split-opacity = 0.9

# Shift+Enter keybind for Claude Code
# Ref: https://github.com/ghostty-org/ghostty/discussions/7419
keybind = shift+enter=text:\x1b\r

auto-update-channel = tip
