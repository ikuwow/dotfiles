#!/usr/bin/env bash
# AI-draft a commit message via `claude -p`, authenticated by the Claude
# Code login. No-op when the claude CLI is not on PATH; any CLI failure
# propagates under set -eu so git aborts the commit. See README.md.

set -eu

MSG_FILE="$1"
MSG_SOURCE="${2:-}"

# Skip non-interactive commits (-m, --amend, merge, squash, template).
if [ -n "$MSG_SOURCE" ]; then exit 0; fi
if [ "${GIT_AI_COMMIT_MSG:-1}" = "0" ]; then exit 0; fi
if ! command -v claude >/dev/null 2>&1; then
  echo "prepare-commit-msg: claude CLI not found, skipping AI draft" >&2
  exit 0
fi

DIFF=$(git diff --cached)
if [ -z "$DIFF" ]; then exit 0; fi

# git log fails on the very first commit; empty RECENT is fine.
RECENT=$(git log -n 10 --pretty=format:'%s' 2>/dev/null || true)

PROMPT="Draft a git commit message for the staged diff.

Format:
- First line: short subject (~50 chars, imperative mood).
- Blank line.
- Body: 2-5 lines explaining what changed and why, wrapped around 72 chars.
- No Co-authored-by or any other trailer.

Match the style and language of the recent subjects below
(English-only repo -> English; Japanese-mixed repo -> use that style).
No markdown, no quotes, no preamble. Output ONLY the commit message.

--- recent commit subjects (style + language reference) ---
$RECENT
--- end ---"

SYSTEM_PROMPT="You write git commit messages. Output the message only — no preamble, no markdown, no quotes, no trailers."

USER_CONTENT="$PROMPT

--- staged diff ---
$DIFF
--- end diff ---"

MODEL="haiku"
echo "prepare-commit-msg: drafting commit message via claude -p ($MODEL)..." >&2

# Every flag and env var below trims startup work or prompt size: no
# tools, MCP, plugins, hooks, CLAUDE.md, settings files (their language
# setting would override the repo's commit language), skills, session
# file, background traffic, or extended thinking (which otherwise spends
# thousands of output tokens on a short message). Running from TMPDIR keeps the repo's
# git status out of the system prompt.
MSG=$(cd "${TMPDIR:-/tmp}" && printf '%s' "$USER_CONTENT" | \
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
  DISABLE_TELEMETRY=1 \
  DISABLE_ERROR_REPORTING=1 \
  DISABLE_AUTOUPDATER=1 \
  CLAUDE_CODE_DISABLE_THINKING=1 \
  timeout 60 claude -p \
    --model "$MODEL" \
    --effort low \
    --system-prompt "$SYSTEM_PROMPT" \
    --safe-mode \
    --setting-sources "" \
    --tools "" \
    --strict-mcp-config \
    --disable-slash-commands \
    --no-session-persistence \
    --output-format text)

if [ -z "$MSG" ]; then
  echo "prepare-commit-msg: claude -p returned an empty message" >&2
  exit 1
fi

# Strip a single layer of wrapping quotes/backticks — Haiku occasionally wraps output.
FIRST=$(printf '%s\n' "$MSG" | head -n 1)
case "$FIRST" in
  \"*\"|\'*\'|\`*\`)
    REST=$(printf '%s\n' "$MSG" | tail -n +2)
    FIRST=${FIRST#?}; FIRST=${FIRST%?}
    if [ -n "$REST" ]; then
      MSG=$(printf '%s\n%s' "$FIRST" "$REST")
    else
      MSG="$FIRST"
    fi
    ;;
esac

TMP=$(mktemp "${MSG_FILE}.aimsg.XXXXXX")
{
  printf '%s\n\n' "$MSG"
  cat "$MSG_FILE"
} >"$TMP"
mv "$TMP" "$MSG_FILE"
